      key: data.key,
      data: data.data || '',
      dataInicial: data.dataInicial || '',
      dataFinal: data.dataFinal || '',
      possuiHorarioDistribuido: Boolean(data.possuiHorarioDistribuido),
      days: data.days.map((day) => ({
