  function parseDateBRToSortValue(value) {
    const match = String(value || '').trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!match) return 0;

    const [, dd, mm, yyyy] = match;
    return Number(`${yyyy}${mm}${dd}`);
