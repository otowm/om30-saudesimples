  function isMarkedForDestroy(el) {
    if (!el || !el.name) return false;

    const prefixes = getPossibleDestroyPrefixes(el.name);

    return prefixes.some((prefix) => {
      const allFields = getAllNamedFields();

      const destroyCheckbox = allFields.find((field) => {
        return field.name === `${prefix}[_destroy]`
          && field.matches('input[type="checkbox"]');
      });

      if (destroyCheckbox) return destroyCheckbox.checked;

      const destroyInput = allFields.find((field) => field.name === `${prefix}[_destroy]`);
      if (!destroyInput) return false;

      return destroyInput.value === '1' || destroyInput.value === 'true';
    });
  }

  function getPossibleDestroyPrefixes(name) {
    const prefixes = [];

    const mapaPeriodoKey = extractMapaPeriodoKey(name);
    const mapaPeriodoValidoKey = extractMapaPeriodoValidoKey(name);
    const mapaDiaKey = extractMapaDiaKey(name);
    const mapaHorarioKey = extractMapaHorarioKey(name);

    if (mapaPeriodoKey) {
      const periodPrefix = `agenda[agendas_mapas_periodos_attributes][${mapaPeriodoKey}]`;
      prefixes.push(...buildMapaDestroyPrefixes(periodPrefix, mapaDiaKey, mapaHorarioKey));
    }

    if (mapaPeriodoValidoKey) {
      const periodPrefix = `agenda[agendas_mapas_periodos_validos_attributes][${mapaPeriodoValidoKey}]`;
      prefixes.push(...buildMapaDestroyPrefixes(periodPrefix, mapaDiaKey, mapaHorarioKey));
    }

    const especificaDiaKey = extractEspecificaDiaKey(name);
    const especificaHorarioKey = extractEspecificaHorarioKey(name);

    if (especificaDiaKey) {
      const especificaDiaPrefix = `agenda[agendas_especificas_dias_attributes][${especificaDiaKey}]`;
      prefixes.push(especificaDiaPrefix);

      if (especificaHorarioKey) {
        prefixes.push(`${especificaDiaPrefix}[agendas_especificas_horarios_attributes][${especificaHorarioKey}]`);
      }
    }

    return prefixes;
  }

  function buildMapaDestroyPrefixes(periodPrefix, mapaDiaKey, mapaHorarioKey) {
    const prefixes = [periodPrefix];

    if (mapaDiaKey) {
      const dayPrefix = `${periodPrefix}[agendas_mapas_dias_attributes][${mapaDiaKey}]`;
      prefixes.push(dayPrefix);

      if (mapaHorarioKey) {
        prefixes.push(`${dayPrefix}[agendas_mapas_horarios_attributes][${mapaHorarioKey}]`);
      }
    }

    return prefixes;
  }

  function groupBy(items, getKey) {
    const map = new Map();

    items.forEach((item) => {
      const key = getKey(item);

      if (!map.has(key)) map.set(key, []);
      map.get(key).push(item);
    });

    return map;
  }

  function debounce(fn, wait) {
    let timer = null;

    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), wait);
    };
  }

