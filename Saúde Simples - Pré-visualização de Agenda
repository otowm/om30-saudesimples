  function findLabelForInput(input, holder) {
    if (input && input.id) {
      const escapedId = cssEscape(input.id);

      const label = holder.querySelector(`label[for="${escapedId}"]`)
        || document.querySelector(`label[for="${escapedId}"]`);

      if (label) return label;
