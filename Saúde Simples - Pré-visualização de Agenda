  function startLivePolling() {
    stopLivePolling();

    livePollTimer = window.setInterval(() => {
      if (!contextoAtual || document.hidden) return;
      if (document.querySelector('#ss-agenda-preview-side-panel:focus-within')) return;

      const data = collectPreviewData(contextoAtual);
      if (!data) return;

