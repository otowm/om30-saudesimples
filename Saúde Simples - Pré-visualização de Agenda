  }

  function extractEspecificaDiaKey(name) {
    const match = String(name || '').match(ESPECIFICA_DIA_RE);
    return match ? match[1] : null;
  }

  function extractEspecificaHorarioKey(name) {
    const match = String(name || '').match(ESPECIFICA_HORARIO_RE);
